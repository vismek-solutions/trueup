{
  "name": "@vismek-solutions/trueup",
  "version": "0.0.0",
  "private": true,
  "description": "Checks that a TypeScript codebase still has the shape you meant it to have, and blocks an edit that would change it",
  "keywords": [
    "architecture",
    "boundaries",
    "dependency-graph",
    "static-analysis",
    "typescript",
    "claude-code",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "trueup": "./dist/cli/entry.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R ../../apps/docs/src/content/docs dist/docs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "TRUEUP_MUTATION=1 stryker run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oxc-parser": "^0.148.0",
    "oxc-resolver": "^11.24.2",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
