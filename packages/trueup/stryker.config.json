{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "related": false },
  "disableTypeChecks": false,
  "reporters": ["progress", "clear-text", "json"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "concurrency": 6,
  "tempDirName": ".stryker-tmp",
  "incremental": true,
  "incrementalFile": "node_modules/.stryker-reports/incremental.json",
  "tsconfigFile": "tsconfig.stryker-skip.json",
  "jsonReporter": { "fileName": "node_modules/.stryker-reports/mutation.json" },
  "clearTextReporter": { "allowColor": false, "maxTestsToLog": 0 },
  "mutate": ["src/**/*.ts"],
  "thresholds": { "high": 90, "low": 78, "break": 76 }
}
