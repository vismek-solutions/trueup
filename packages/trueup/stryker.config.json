{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "related": false },
  "disableTypeChecks": false,
  "reporters": ["progress", "clear-text", "json"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "tempDirName": "node_modules/.stryker-tmp",
  "tsconfigFile": "tsconfig.stryker-skip.json",
  "jsonReporter": { "fileName": "node_modules/.stryker-reports/mutation.json" },
  "clearTextReporter": { "allowColor": false, "maxTestsToLog": 0 },
  "mutate": ["src/claims/members/*.ts", "src/cli/init/*.ts"],
  "thresholds": { "high": 90, "low": 70, "break": null }
}
