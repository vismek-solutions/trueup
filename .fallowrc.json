{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "packages/trueup/src/index.ts",
    "packages/trueup/bin/trueup.js",
    "packages/trueup/trueup.config.ts",
    "trueup.config.ts",
    "apps/docs/src/styles/custom.css"
  ],
  "duplicates": {
    "mode": "weak",
    "minLines": 13,
    "minTokens": 30
  },
  "ignorePatterns": ["**/test/fixtures/**"],
  "rules": {
    "private-type-leaks": "error",
    "require-suppression-reason": "error"
  }
}
