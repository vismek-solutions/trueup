{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/test/fixtures", "!research"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "off" }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } },
        "noForEach": "error",
        "useOptionalChain": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error",
        "noReExportAll": "error"
      },
      "style": {
        "noEnum": "error",
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 250 } },
        "noInferrableTypes": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useShorthandFunctionType": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noDoubleEquals": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noImportCycles": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noTsIgnore": "error",
        "useAwait": "error",
        "useErrorMessage": "error"
      }
    }
  }
}
