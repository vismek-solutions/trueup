{
  "name": "trueup-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node ./packages/trueup/bin/trueup.js",
    "docs": "node ./packages/trueup/bin/trueup.js docs",
    "biome": "biome check --write --unsafe .",
    "test": "pnpm --filter trueup run test",
    "typecheck": "pnpm --filter trueup run typecheck",
    "build": "pnpm --filter trueup run build",
    "staged": "npm stage list @vismek-solutions/trueup",
    "approve": "node ./scripts/approve-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "fallow": "^3.25.0",
    "oxlint": "^1.82.0"
  }
}
